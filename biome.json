{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!docs/public/config.schema.json"] },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "linter": { "rules": { "preset": "recommended", "suspicious": { "noImportCycles": "error" } } },
  "overrides": [
    {
      "includes": ["test/**", "scripts/demo/**"],
      "linter": { "rules": { "suspicious": { "noTemplateCurlyInString": "off" } } }
    },
    {
      "includes": ["src/**", "!src/cli/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/cli/**", "#cli/**"],
                    "message": "Only src/cli imports the CLI."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/util/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", "#*/**"],
                    "message": "src/util imports only node: and npm packages."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
